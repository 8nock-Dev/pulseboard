# Database
DATABASE_URL=postgresql://pulseboard:pulseboard_secret@localhost:5432/pulseboard
DATABASE_SSL=false

# Auth
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Email alerts (optional - leave blank to disable email alerts)
# Works with any SMTP provider: Gmail, SendGrid, Mailgun, etc.
# For Gmail: use an App Password (not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=PulseBoard <your@gmail.com>
